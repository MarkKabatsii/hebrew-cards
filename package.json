{
  "name": "hebrew-cards",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/progress.test.cjs tests/import.test.cjs && node --import tsx --test tests/learning*.test.ts",
    "test:browser": "node tests/examples.browser.cjs && node --import tsx tests/learning.browser.cjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  },
  "overrides": {
    "esbuild": "0.24.2"
  }
}
